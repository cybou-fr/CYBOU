[Unit]
Description=Cybou read-only web gateway
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=cybou
Group=cybou
Environment=CYBOU_WEB_ROOT=/usr/share/cybou/web
Environment=CYBOU_GATEWAY_FIXTURE=1
ExecStart=/usr/libexec/cybou/cybou-web-gateway
Restart=on-failure
RestartSec=1
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes

[Install]
WantedBy=multi-user.target
