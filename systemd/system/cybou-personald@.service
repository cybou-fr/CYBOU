#
# One instance per explicitly admitted Linux account:
#   systemctl enable --now cybou-personald@alice.service
#
# The gateway partitioned personal records by UID; this owns them. The process runs as the person,
# its store lives in that person's home, and no request that reaches its socket can name another
# account — there is no UID field in its protocol at all.

[Unit]
Description=Cybou Personal Core owner for %i
Documentation=https://github.com/cybou-fr/CYBOU
After=cybou-authd.service

[Service]
Type=simple
ExecStart=/usr/libexec/cybou/cybou-personald-runner.sh %i

Restart=on-failure
RestartSec=1
UMask=0077
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/%i /run/cybou-personal
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
RestrictSUIDSGID=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
RestrictAddressFamilies=AF_UNIX
RestrictRealtime=yes
LockPersonality=yes
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
