#
# Root is the Body capability: Action1 runs without it and this process owns no authorization
# policy. Its only public argument is a short-lived permit identity that it atomically claims back
# from Action1 before touching the host.

[Unit]
Description=Cybou typed Body action executor
Documentation=https://github.com/cybou-fr/CYBOU
After=dbus.service
Wants=dbus.service

[Service]
Type=dbus
BusName=org.cybou.Body.Executor1
ExecStart=/usr/libexec/cybou/cybou-executord
Environment=CYBOU_EXECUTOR_SYSTEM_BUS=1
Environment=CYBOU_ACTION_SYSTEM_BUS=1
Restart=on-failure
RestartSec=1

User=root
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
# Installing and upgrading software writes to /usr, /var/lib/dpkg and /etc and fetches over the
# network. `ProtectSystem=full` and a Unix-only address family made both impossible, so the two
# protections that stand between this process and a package manager are relaxed — deliberately, and
# only because the host now has typed operations that need them. The executor still authorizes
# nothing: every apt invocation it makes exists because Action1 issued a permit for one named
# package, and the package name is checked against Debian's own naming rule before it can reach a
# command line. Moving apt into its own transient unit with its own sandbox would let this one go
# back to `full`, and is the next thing worth doing here.
ProtectSystem=no
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
