#
# One instance per explicitly admitted Linux account:
#   systemctl enable --now cybou-host-filesd@alice.service
#
# The process never has gateway group authority. systemd creates a private per-UID runtime
# directory, the owner binds there as itself, then the two '+' post-start operations expose only
# that directory and socket to the gateway group. The user can disrupt or replace their own socket
# because they own its directory; that changes only answers for their own authenticated UID.

[Unit]
Description=Cybou HostUserPath owner for %i
Documentation=https://github.com/cybou-fr/CYBOU
After=cybou-authd.service

[Service]
Type=simple
ExecStart=/usr/libexec/cybou/cybou-host-filesd-runner.sh %i

Restart=on-failure
RestartSec=1
UMask=0077
ProtectSystem=strict
ProtectHome=read-only
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
RestrictAddressFamilies=AF_UNIX
RestrictRealtime=yes
LockPersonality=yes
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target

