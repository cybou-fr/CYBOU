[Unit]
Description=Cybou private model gateway for agent capsule %i
Documentation=https://github.com/cybou-fr/CYBOU
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=cybou
Group=cybou
UMask=0077
RuntimeDirectory=cybou-agent-%i
RuntimeDirectoryMode=0700

# Provider policy has no secret. The authority is the lease itself, minted once by the session owner
# and delivered as bytes: this unit re-derives none of it. The environment file carries only what is
# not authority — the task id and the per-token ceilings. A missing lease or file is a failed launch,
# never broad authority.
EnvironmentFile=/etc/cybou/provider.env
EnvironmentFile=/run/cybou-agent-leases/%i.env
LoadCredential=litellm-master:/etc/cybou/litellm-master-key
Environment=CYBOU_LITELLM_MASTER_KEY_FILE=%d/litellm-master
Environment=CYBOU_AGENT_LEASE_FILE=/run/cybou-agent-leases/%i.lease
Environment=CYBOU_AGENT_RUNTIME_DIR=/run/cybou-agent-%i

# The lease is a path this service opens itself, and deliberately not a LoadCredential.
#
# LoadCredential is read by the *service manager*, which is root, and it follows symlinks — measured,
# not assumed: a credential loaded from a symlink to a root-only 0600 file delivers that file's
# contents to an unprivileged service. Since the session owner runs as cybou and must be able to write
# its own lease, /run/cybou-agent-leases is cybou-owned, so loading the lease that way would let cybou
# name any root-only file and have root read it out — the master key below among them, which is the
# one thing this unit exists to keep out of cybou's reach.
#
# Opened by this service instead, it is cybou reading a file cybou wrote. No boundary is crossed and
# there is nothing to escalate. The master key stays a credential because its source lives in
# /etc/cybou, which is root-owned and where cybou cannot put a symlink.

ExecStart=/usr/libexec/cybou/cybou-agent-gateway
Restart=no

NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=read-only
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native

# Deliberately no [Install]: a capsule lease, not boot, owns this process.
