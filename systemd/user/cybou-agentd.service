[Unit]
Description=Cybou Agent1 session runtime
Documentation=https://github.com/cybou-fr/CYBOU

# Deliberately not PartOf=cybou-mind.target. An agent runtime is not an organ of Mind: it starts,
# holds and ends capsules containing software Cybou did not write and does not trust. Binding it to
# the target that carries Mind would make stopping Mind stop the thing watching those capsules, and
# would say, in the one place an operator looks, that the two are parts of each other.

[Service]
Type=dbus
BusName=org.cybou.Runtime.Agent1
ExecStart=/usr/libexec/cybou/cybou-agentd serve
Restart=on-failure
RestartSec=1

# No sandbox that would cut this off from what it owns. It has to reach the session manager to ask
# which capsules are still up and to stop them, and it has to read the launch directory it writes.
# Everything below is what can be restricted without taking away one of those.
NoNewPrivileges=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
RestrictAddressFamilies=AF_UNIX
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native

[Install]
WantedBy=default.target
