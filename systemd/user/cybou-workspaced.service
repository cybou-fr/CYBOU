[Unit]
Description=Cybou Workspace1 Global Workspace Attention Coalitions Service
Documentation=https://github.com/cybou-fr/CYBOU
After=cybou-eventd.service
PartOf=cybou-mind.target

[Service]
Type=dbus
BusName=org.cybou.Mind.Workspace1
ExecStart=/usr/libexec/cybou/cybou-workspaced
Restart=on-failure
RestartSec=1
NoNewPrivileges=yes
RestrictAddressFamilies=AF_UNIX
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes

[Install]
WantedBy=default.target
