[Unit]
Description=Cybou ModelBroker1 Model Brokerage Faculty
Documentation=https://github.com/cybou-fr/CYBOU
PartOf=cybou-mind.target

[Service]
Type=dbus
BusName=org.cybou.Faculty.ModelBroker1
ExecStart=/usr/libexec/cybou/cybou-model-brokerd
Restart=on-failure
RestartSec=1
NoNewPrivileges=yes
# No network. No remote route is configured, so the faculty has no reason to reach one, and a
# broker that could is one configuration mistake away from being the egress nobody noticed. A
# deployment that adds a remote provider has to remove this line, which is the point: it is a
# decision somebody makes rather than a default nobody sees.
RestrictAddressFamilies=AF_UNIX
PrivateNetwork=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
# It owns no state. A faculty that selects, budgets and attributes needs nothing on disk, and
# anything it could write would be a second memory with different rules.
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes

[Install]
WantedBy=default.target
