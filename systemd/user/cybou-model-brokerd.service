[Unit]
Description=Cybou ModelBroker1 Model Brokerage Faculty
Documentation=https://github.com/cybou-fr/CYBOU
PartOf=cybou-mind.target

[Service]
Type=dbus
BusName=org.cybou.Faculty.ModelBroker1
ExecStart=/usr/libexec/cybou/cybou-model-brokerd
Restart=on-failure
RestartSec=1
NoNewPrivileges=yes
# Egress is governed here, not prohibited. This unit shipped with PrivateNetwork=yes for one day, on
# the reasoning that a broker able to reach a network is one mistake away from being the egress
# nobody noticed. That is a good argument on a personal machine and the wrong default on a host
# whose reason for existing is to be reached (ADR-0041).
#
# What actually protects this: no remote route is configured, so there is nothing to reach; adding
# one is a decision; and what crosses is what a disclosure decision supplied and recorded. A
# namespace flag would have made that machinery feel optional, which is the worse outcome — the
# recorded, refusable route is the protection, and it has to be the one that works.
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
# It owns no state. A faculty that selects, budgets and attributes needs nothing on disk, and
# anything it could write would be a second memory with different rules.
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes

[Install]
WantedBy=default.target
