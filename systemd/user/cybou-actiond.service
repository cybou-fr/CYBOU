[Unit]
Description=Cybou Action1 authorization lifecycle
Documentation=https://github.com/cybou-fr/CYBOU
PartOf=cybou-mind.target

[Service]
# This remains a non-root user process, but exports on the system bus so the root executor can
# authenticate to the same transport. A system user manager cannot track a system-bus name as
# Type=dbus, so readiness is enforced by the executor's permit-source connection and restart gate.
Type=simple
ExecStart=/usr/libexec/cybou/cybou-actiond
Environment=CYBOU_ACTION_SYSTEM_BUS=1
EnvironmentFile=-/etc/cybou/action-policy.env
Restart=on-failure
RestartSec=1

NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_UNIX
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native

[Install]
WantedBy=default.target
