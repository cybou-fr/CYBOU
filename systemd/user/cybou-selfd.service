[Unit]
Description=Cybou Self1 Continuous Self-Model and Narration Service
Documentation=https://github.com/cybou-fr/CYBOU
After=cybou-identityd.service
PartOf=cybou-mind.target

[Service]
Type=dbus
BusName=org.cybou.Mind.Self1
ExecStart=/usr/libexec/cybou/cybou-selfd
Restart=on-failure
RestartSec=1
NoNewPrivileges=yes
RestrictAddressFamilies=AF_UNIX
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes

[Install]
WantedBy=default.target
