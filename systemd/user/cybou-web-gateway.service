#
# The gateway is a consumer of Mind, so it runs where Mind runs: in the cybou user manager, on the
# same session bus. As a system service it had no session bus at all and could only ever serve
# fixtures.

[Unit]
Description=Cybou read-only web gateway
Documentation=https://github.com/cybou-fr/CYBOU
After=cybou-presenced.service
PartOf=cybou-mind.target

[Service]
Type=simple
Environment=CYBOU_WEB_ROOT=/usr/share/cybou/web
# Nothing is served until somebody signs in. This was public-preview, which served a filtered
# projection of a live Mind to anyone who had the address; filtering is not the same as not
# showing, and the person it was about had not agreed to either.
Environment=CYBOU_SESSION_MODE=sign-in-required

# Everyone is served a projection with nothing above ordinary in it. A reader who signs in with a
# Linux account is served the unfiltered one instead. The gateway never checks the password itself:
# it asks cybou-authd over this socket, which is the only process with the privilege to look. An
# unset path means this deployment cannot authenticate anybody, which is a valid way to run a
# public demo.
Environment=CYBOU_AUTH_SOCKET=/run/cybou/auth.sock

ExecStart=/usr/libexec/cybou/cybou-web-gateway
Restart=on-failure
RestartSec=1
NoNewPrivileges=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes

[Install]
WantedBy=default.target
