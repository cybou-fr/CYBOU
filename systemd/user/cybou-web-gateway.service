#
# The gateway is a consumer of Mind, so it runs where Mind runs: in the cybou user manager, on the
# same session bus. As a system service it had no session bus at all and could only ever serve
# fixtures.

[Unit]
Description=Cybou read-only web gateway
Documentation=https://github.com/cybou-fr/CYBOU
After=cybou-presenced.service
PartOf=cybou-mind.target

[Service]
Type=simple
Environment=CYBOU_WEB_ROOT=/usr/share/cybou/web
Environment=CYBOU_SESSION_MODE=public-preview
ExecStart=/usr/libexec/cybou/cybou-web-gateway
Restart=on-failure
RestartSec=1
NoNewPrivileges=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes

[Install]
WantedBy=default.target
