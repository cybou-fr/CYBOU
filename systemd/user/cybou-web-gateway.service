#
# The gateway is a consumer of Mind, so it runs where Mind runs: in the cybou user manager, on the
# same session bus. As a system service it had no session bus at all and could only ever serve
# fixtures.

[Unit]
Description=Cybou read-only web gateway
Documentation=https://github.com/cybou-fr/CYBOU
After=cybou-presenced.service
PartOf=cybou-mind.target

[Service]
Type=simple
Environment=CYBOU_WEB_ROOT=/usr/share/cybou/web
Environment=CYBOU_SESSION_MODE=public-preview

# Everyone is served a projection with nothing above ordinary in it. A reader presenting the
# credential in this file is served the unfiltered one instead. The path is here and the secret is
# not, because a unit file is world-readable; an unset path means this deployment entitles nobody,
# which is a valid way to run a public demo.
Environment=CYBOU_ACCESS_CREDENTIAL_FILE=/var/lib/cybou/access-credential

ExecStart=/usr/libexec/cybou/cybou-web-gateway
Restart=on-failure
RestartSec=1
NoNewPrivileges=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes

[Install]
WantedBy=default.target
