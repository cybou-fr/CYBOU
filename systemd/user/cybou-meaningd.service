[Unit]
Description=Cybou Meaning1 Meaning Boundary Service
Documentation=https://github.com/cybou-fr/CYBOU
After=cybou-eventd.service
PartOf=cybou-mind.target

[Service]
Type=dbus
BusName=org.cybou.Mind.Meaning1
ExecStart=/usr/libexec/cybou/cybou-meaningd
Restart=on-failure
RestartSec=1
NoNewPrivileges=yes
RestrictAddressFamilies=AF_UNIX
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes

[Install]
WantedBy=default.target
