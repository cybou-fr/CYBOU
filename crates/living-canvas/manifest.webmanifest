{
  "name": "Cybou Desktop",
  "short_name": "Cybou",
  "id": "/",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone"],
  "orientation": "any",
  "background_color": "#070A0E",
  "theme_color": "#070A0E",
