{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cybou.org/schemas/web/v1/mind.schema.json",
  "title": "Cybou Mind panel projection v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "observedAt",
    "identity",
    "journal",
    "commitments",
    "lifecycle",
    "selfModel",
    "attention",
    "beliefs",
    "perception",
    "context"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "observedAt": {
      "type": "string",
      "format": "date-time"
    },
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "knowledge",
        "identityId",
        "origin",
        "sessionCount",
        "ageInDays",
        "architectureVersion"
      ],
      "properties": {
        "knowledge": {
          "enum": [
            "known",
            "unknown"
          ]
        },
        "identityId": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "origin": {
          "type": [
            "string",
            "null"
          ]
        },
        "sessionCount": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "ageInDays": {
          "type": [
            "integer",
            "null"
          ]
        },
        "architectureVersion": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "journal": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "knowledge",
        "contributionCount",
        "erasureEpoch",
        "recent",
        "integrity"
      ],
      "properties": {
        "knowledge": {
          "enum": [
            "known",
            "unknown"
          ]
        },
        "contributionCount": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "erasureEpoch": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "recent": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "messageId",
              "kind",
              "originOrgan",
              "recordedAt"
            ],
            "properties": {
              "messageId": {
                "type": "string",
                "minLength": 1
              },
              "kind": {
                "type": "string",
                "minLength": 1
              },
              "originOrgan": {
                "type": "string"
              },
              "recordedAt": {
                "type": "string",
                "format": "date-time"
              }
            }
          }
        },
        "integrity": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "commitments": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "knowledge",
        "openCount",
        "open"
      ],
      "properties": {
        "knowledge": {
          "enum": [
            "known",
            "unknown"
          ]
        },
        "openCount": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "open": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "description",
              "trigger",
              "formed"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "description": {
                "type": "string"
              },
              "trigger": {
                "type": "string"
              },
              "formed": {
                "type": "string",
                "format": "date-time"
              }
            }
          }
        }
      }
    },
    "lifecycle": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "knowledge",
        "mode",
        "lastUserActivityAt"
      ],
      "properties": {
        "knowledge": {
          "enum": [
            "known",
            "unknown"
          ]
        },
        "mode": {
          "type": [
            "string",
            "null"
          ]
        },
        "lastUserActivityAt": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "selfModel": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "knowledge",
        "narration",
        "ageInDays",
        "sessions",
        "openIntentions",
        "settledPredictions"
      ],
      "properties": {
        "knowledge": {
          "enum": [
            "known",
            "unknown"
          ]
        },
        "narration": {
          "type": [
            "string",
            "null"
          ]
        },
        "ageInDays": {
          "type": [
            "integer",
            "null"
          ]
        },
        "sessions": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "openIntentions": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "settledPredictions": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        }
      }
    },
    "attention": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "knowledge",
        "focus",
        "salience",
        "organs"
      ],
      "properties": {
        "knowledge": {
          "enum": [
            "known",
            "unknown"
          ]
        },
        "focus": {
          "type": [
            "string",
            "null"
          ]
        },
        "salience": {
          "type": [
            "number",
            "null"
          ]
        },
        "organs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "beliefs": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "knowledge",
        "beliefs"
      ],
      "properties": {
        "knowledge": {
          "enum": [
            "known",
            "unknown"
          ]
        },
        "beliefs": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "subject",
              "value",
              "confidence",
              "status",
              "lastCorroboratedAt"
            ],
            "properties": {
              "subject": {
                "type": "string",
                "minLength": 1
              },
              "value": {
                "type": "string"
              },
              "confidence": {
                "type": "number"
              },
              "status": {
                "type": "string",
                "minLength": 1
              },
              "lastCorroboratedAt": {
                "type": "string",
                "format": "date-time"
              }
            }
          }
        }
      }
    },
    "perception": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "knowledge",
        "status",
        "acquiredAt",
        "sourceId"
      ],
      "properties": {
        "knowledge": {
          "enum": [
            "known",
            "unknown"
          ]
        },
        "status": {
          "type": [
            "string",
            "null"
          ]
        },
        "acquiredAt": {
          "type": [
            "string",
            "null"
          ]
        },
        "sourceId": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "context": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "knowledge",
        "concepts"
      ],
      "properties": {
        "knowledge": {
          "enum": [
            "known",
            "unknown"
          ]
        },
        "concepts": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "label",
              "salience",
              "activationReason",
              "lastActivatedAt"
            ],
            "properties": {
              "label": {
                "type": "string",
                "minLength": 1
              },
              "salience": {
                "type": "number"
              },
              "activationReason": {
                "type": "string"
              },
              "lastActivatedAt": {
                "type": "string",
                "format": "date-time"
              }
            }
          }
        }
      }
    }
  }
}
